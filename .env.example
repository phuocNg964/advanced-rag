# =========================
# LLM Configuration
# =========================
# At least one provider key is required; which one depends on your configs/model/models.yaml.
# The default models.yaml uses Groq for primary text/image roles and Gemini/Gemma as fallbacks.

# Required by the default config
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Optional (uncomment if your models.yaml uses these providers)
# OPENAI_API_KEY=your_openai_api_key_here

# =========================
# Weaviate (defaults work with docker-compose.yaml)
# =========================
# WEAVIATE_HOST=localhost
# WEAVIATE_HTTP_PORT=8080
# WEAVIATE_GRPC_PORT=50051

# =========================
# Reranker
# =========================
# CPU default: app-level mMARCO reranker via sentence-transformers.
# GPU Docker mode sets RERANKER_MODE=weaviate through docker-compose.gpu.yaml
# so Weaviate calls reranker-transformers:bge-reranker-v2-m3.
RERANKER_MODE=app
APP_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
APP_RERANKER_DEVICE=cpu
APP_RERANKER_BATCH_SIZE=8
WARMUP_RERANKER=true

# Retrieval defaults. App reranking is applied once after all sub-query results are deduplicated.
RETRIEVAL_TOP_K=20
RETRIEVAL_TOP_K_RERANKER=5
RETRIEVAL_ALPHA=0.5

# CPU default: text2vec only. docker-compose.gpu.yaml enables reranker-transformers.
WEAVIATE_ENABLE_MODULES=text2vec-transformers
# WEAVIATE_RERANKER_INFERENCE_API=http://reranker-transformers:8080

# =========================
# Docker resource limits
# =========================
# Defaults are tuned for local Docker Desktop. Increase Weaviate limits when
# indexed chunks grow substantially; increase text2vec if BGE-M3 inference OOMs.
WEAVIATE_MEM_LIMIT=2g
WEAVIATE_MEMSWAP_LIMIT=2g
WEAVIATE_GOMEMLIMIT=1536MiB
TEXT2VEC_MEM_LIMIT=4g
TEXT2VEC_MEMSWAP_LIMIT=4g

# =========================
# Runtime
# =========================
# Docker defaults to false so first startup is lighter. Set true if you prefer
# paying Docling's warmup cost at startup instead of on the first upload.
WARMUP_DOCLING=false
MAX_UPLOAD_SIZE_MB=100

# =========================
# Database (Postgres) - defaults match docker-compose.yaml
# =========================
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/agentic-rag
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=agentic-rag
PG_HOST=127.0.0.1
PG_PORT=5432
PG_POOL_MAX_SIZE=5

# =========================
# Observability (Phoenix Tracing)
# =========================
# Set to enable tracing. Leave unset to disable for local source runs.
# Docker dev compose enables tracing and sends traces to http://phoenix:4317.
# Local source tracing: http://localhost:4317 while the dev Docker stack is running.
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:4317
