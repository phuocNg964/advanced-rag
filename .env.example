# =========================
# LLM Configuration
# =========================
# At least one provider key is required — which one depends on your configs/model/models.yaml.
# The default models.yaml uses Groq, so GROQ_API_KEY is required out of the box.

# Required (default config uses Groq)
GROQ_API_KEY=your_groq_api_key_here

# Optional (uncomment if your models.yaml uses these providers)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# =========================
# Weaviate (defaults work with docker-compose.yaml)
# =========================
# WEAVIATE_HOST=localhost
# WEAVIATE_HTTP_PORT=8080
# WEAVIATE_GRPC_PORT=50051

# =========================
# Reranker
# =========================
# CPU default: app-level mMARCO reranker via sentence-transformers.
# GPU option: set RERANKER_MODE=weaviate when using docker compose --profile gpu
# so Weaviate calls reranker-transformers:bge-reranker-v2-m3.
RERANKER_MODE=app
APP_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
APP_RERANKER_DEVICE=cpu
APP_RERANKER_BATCH_SIZE=8
WARMUP_RERANKER=true

# Retrieval defaults. App reranking is applied once after all sub-query results are deduplicated.
RETRIEVAL_TOP_K=20
RETRIEVAL_TOP_K_RERANKER=5

# CPU default: text2vec only. GPU + Weaviate reranker: set to reranker-transformers,text2vec-transformers.
WEAVIATE_ENABLE_MODULES=text2vec-transformers
# WEAVIATE_RERANKER_INFERENCE_API=http://reranker-transformers:8080

# =========================
# Runtime
# =========================
# Docker defaults to false so first startup is lighter. Set true if you prefer
# paying Docling's warmup cost at startup instead of on the first upload.
WARMUP_DOCLING=false
MAX_UPLOAD_SIZE_MB=100

# =========================
# Database (Postgres) — defaults match docker-compose.yaml
# =========================
# PG_USER=postgres
# PG_PASSWORD=postgres
# PG_DATABASE=agentic-rag
PG_HOST=localhost
PG_POOL_MAX_SIZE=5

# =========================
# Observability (Phoenix Tracing)
# =========================
# Set to enable tracing. Leave unset to disable for local source runs.
# Local dev:  http://localhost:4317  (run Phoenix via docker-compose)
# Docker:     docker-compose defaults API tracing to http://phoenix:4317
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:4317
# DOCKER_PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:4317
